# JAPAR Akademi — ÜRETİM ortam değişkenleri (docker/compose.prod.yml)
#   cp docker/.env.production.example docker/.env.production   → değerleri doldurun. Bu dosya repoya GİRMEZ.
# Rastgele değer üretmek için: openssl rand -hex 32   /  base64: openssl rand -base64 32

# ---- Alan adları ve imajlar ----
APP_DOMAIN=akademi.japar.com.tr
# Dosya deposu (imzalı URL'ler bu adresten açılır)
FILES_DOMAIN=dosya.akademi.japar.com.tr
ACME_EMAIL=bt@japar.com.tr
APP_IMAGE=ghcr.io/keremircan/japar-akademi-app:latest
WORKER_IMAGE=ghcr.io/keremircan/japar-akademi-worker:latest

# ---- Uygulama ----
LOG_LEVEL=info

# ---- Veritabanı (compose bağlantı adreslerini bu şifrelerle kurar) ----
POSTGRES_SUPERUSER_PASSWORD=
AKADEMI_OWNER_PASSWORD=
AKADEMI_APP_PASSWORD=

# ---- Kimlik doğrulama ve KVKK ----
BETTER_AUTH_SECRET=
NATIONAL_ID_ENC_KEYS=
NATIONAL_ID_HMAC_KEY=

# ---- Depolama (Garage) ----
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
GARAGE_CAPACITY_GB=200
S3_REGION=garage
# "GK" + 24 hex / 64 hex  (storage-init bu anahtarı Garage'a tanımlar)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=akademi-private

# ---- E-posta (Microsoft Graph, Mail.Send) ----
MAIL_TRANSPORT=graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_FROM=

# ---- İlk sistem yöneticisi (seed) ----
SEED_ADMIN_SICIL=000001
SEED_ADMIN_PASSWORD=
# Üretimde boş bırakın (demo kullanıcı/içerik oluşturulmaz)
SEED_DEMO_PASSWORD=

# ---- Yedekleme ----
# age genel anahtarı (age-keygen ile üretilir; GİZLİ anahtar sunucuda TUTULMAZ, kasada saklanır)
BACKUP_AGE_RECIPIENT=
# Dosya yedeği şifresi (rclone crypt)
BACKUP_FILES_PASSWORD=
# Yedeklerin yazılacağı sunucu dizini (varsayılan docker/backups)
BACKUP_DIR=
# İsteğe bağlı uzak hedef (Türkiye'de S3 uyumlu depolama), rclone biçimiyle; örn:
#   :s3,provider=Other,endpoint=https://s3.ornek.com.tr,access_key_id=...,secret_access_key=...:akademi-yedek
BACKUP_REMOTE=
