# JAPAR Akademi — ortam değişkenleri
# Kopyala: cp .env.example .env  (".env" repoya girmez)
# Aşağıdaki veritabanı ve depolama değerleri docker/compose.yml'deki YEREL geliştirme değerleridir.

# ---- Uygulama ----
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Veritabanı ----
# Uygulama ve worker en az yetkili kullanıcıyla bağlanır
DATABASE_URL=postgres://akademi_app:akademi_app_dev@localhost:5433/akademi
# Migration'lar tablo sahibi kullanıcıyla çalışır
DATABASE_OWNER_URL=postgres://akademi_owner:akademi_owner_dev@localhost:5433/akademi
# Entegrasyon testleri
TEST_DATABASE_URL=postgres://akademi_app:akademi_app_dev@localhost:5433/akademi_test
TEST_DATABASE_OWNER_URL=postgres://akademi_owner:akademi_owner_dev@localhost:5433/akademi_test

# ---- Kimlik doğrulama ----
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# ---- Depolama (Garage, S3 uyumlu) ----
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
# Anahtar biçimi: "GK" + 24 hex karakter / 64 hex karakter. "npm run storage:init" bu anahtarı Garage'a tanımlar.
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET_PRIVATE=akademi-private
GARAGE_ADMIN_URL=http://localhost:3903
GARAGE_ADMIN_TOKEN=dev-garage-admin-token
# Garage düğüm kapasitesi (GB) — yalnızca ilk düğüm düzeni oluşturulurken kullanılır
GARAGE_CAPACITY_GB=10

# ---- Seed ----
# İlk sistem yöneticisi (ilk girişte şifresini değiştirmek zorundadır)
SEED_ADMIN_SICIL=000001
SEED_ADMIN_PASSWORD=
# Yalnızca geliştirme ortamı: her rol için demo kullanıcıların ortak şifresi
SEED_DEMO_PASSWORD=
